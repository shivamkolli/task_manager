<%= turbo_frame_tag dom_id(task),
    data: {
      task_filter_target: "task",
      status: task.status,
      priority: task.priority
    } do %>

  <div class="mb-4 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">

    <div class="flex items-start justify-between gap-4">

      <div>

        <h3 class="text-lg font-semibold text-gray-900">
          <%= task.title %>
        </h3>

        <% if task.description.present? %>
          <p class="mt-2 text-sm text-gray-600">
            <%= task.description %>
          </p>
        <% end %>

      </div>

      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium">
        <%= task.priority.humanize %>
      </span>

    </div>


    <div class="mt-4 flex items-center justify-between">

      <!-- Status -->
      <%= form_with model: task,
          class: "inline-flex items-center" do |form| %>

        <%= form.select :status,
            Task::STATUSES.map { |status| [status.humanize, status] },
            {},
            class: "rounded-lg border border-gray-300 px-3 py-1.5 text-sm",
            onchange: "this.form.requestSubmit()" %>

      <% end %>


      <!-- Actions -->
      <div class="flex gap-3 text-sm">

        <%= link_to "Edit",
            edit_task_path(task),
            data: { turbo_frame: dom_id(task) },
            class: "font-medium text-blue-600 hover:text-blue-800" %>

        <%= button_to "Delete",
            task_path(task),
            method: :delete,
            class: "font-medium text-red-600 hover:text-red-800" %>

      </div>

    </div>

  </div>

<% end %>